{
  "private": true,
  "name": "root",
  "version": "0.0.1",
  "scripts": {
    "lint": "biome check --write && lerna exec --ignore @mantou/nes -- tsc --noEmit",
    "release": "lerna version",
    "build:nes": "wasm-pack build --out-dir ../nes-pkg --target web --scope mantou packages/nes",
    "publish:nes": "./scripts/nes-pkg.mjs",
    "publish:nes:test": "./scripts/nes-pkg.mjs --test",
    "preinstall": "yarn build:nes",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.5",
    "@types/node": "^22.13.10",
    "husky": "^8.0.3",
    "lerna": "^8.0.0",
    "lint-staged": "^15.1.0",
    "typescript": "^5.8.3",
    "wasm-pack": "^0.14.0"
  },
  "lint-staged": {
    "*.ts": "biome check --write"
  },
  "workspaces": [
    "games/*",
    "packages/*"
  ],
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
